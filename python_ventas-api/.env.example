# Configuración local de XAMPP (plantilla sin secretos reales)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=venta_vehiculos
DB_USER=root
DB_PASSWORD=

# URL de entrada a la API Spring Boot a través de NGINX (8090)
JAVA_URL=http://127.0.0.1:8090

# Clave interna compartida con app.security.ventas-key de Java (mínimo 32 caracteres)
VENTAS_SERVICE_KEY=COLOCA_AQUI_VENTAS_SERVICE_KEY_DE_32_CARACTERES

# Receptor Spring Boot de notificaciones
NOTIFICACIONES_URL=http://127.0.0.1:8081
NOTIFICACIONES_KEY=COLOCA_AQUI_NOTIFICACIONES_KEY_DE_32_CARACTERES

# Configuración de RabbitMQ para cola durable de notificaciones
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=COLOCA_AQUI_PASSWORD_RABBITMQ
RABBITMQ_QUEUE=notificaciones.ventas
