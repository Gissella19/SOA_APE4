# API de vehículos: configuración de plantilla (sin secretos reales).
server.port=8080
server.address=127.0.0.1

# Conexión local MySQL/MariaDB.
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/venta_vehiculos?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=

# Validación de esquema JPA.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MariaDBDialect

# Autenticación JWT y cliente OAuth2 (reemplazar en entorno local).
app.security.jwt-secret=REEMPLAZAR_CON_SECRETO_BASE64_DE_32_BYTES_MINIMO
app.security.access-token-minutes=30
app.security.refresh-token-minutes=1440
app.security.client-id=vehiculos-client
app.security.client-secret=REEMPLAZAR_CLIENT_SECRET_LOCAL

# Clave interna de integración con python_ventas-api (mínimo 32 caracteres).
app.security.ventas-key=REEMPLAZAR_CON_VENTAS_SERVICE_KEY_DE_32_CARACTERES

# Servicio de notificaciones Java.
servicios.notificaciones.url=http://127.0.0.1:8081
servicios.notificaciones.key=REEMPLAZAR_CON_NOTIFICACIONES_KEY_DE_32_CARACTERES
servicios.notificaciones.destinatario=pruebas@ejemplo.com

# Parámetros de usuarios iniciales para laboratorio.
app.bootstrap.user=admin-local
app.bootstrap.password=REEMPLAZAR_CONTRASENA_LABORATORIO
app.bootstrap.role=ADMIN
